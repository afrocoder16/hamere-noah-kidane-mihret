---
import Base from '../layouts/Base.astro';
import TodayStrip from '../components/TodayStrip.astro';
import ParishNoticeboard from '../components/ParishNoticeboard.astro';
import MeskelCross from '../components/ornament/MeskelCross.astro';
import Harag from '../components/ornament/Harag.astro';
import ArchFrame from '../components/ornament/ArchFrame.astro';
import Divider from '../components/ornament/Divider.astro';
import { KIDASE_ORDER, PARISH, NAME_MEANING, SERVICES } from '../lib/parish';
import { upcomingObservances, ethiopianClockOf, toGeez } from '../lib/ethiopic';
import { u } from '../lib/url';
import { getCollection } from 'astro:content';

const feasts = upcomingObservances(new Date(), 5);
const sunday = SERVICES.find((s) => s.title.startsWith('Kidase'))!;
const parishUpdates = (await getCollection('parishUpdates', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf());
const latestParishUpdate = parishUpdates[0];
---

<Base title="Home" bleed>
  <!-- ══════════════════════════ HERO ══════════════════════════ -->
  <section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-ink-950">
    <!-- the angel-painted ceiling of Debre Berhan Selassie, looking up -->
    <picture class="absolute inset-0" aria-hidden="true">
      <source srcset={u('/pics/hero-angels.webp')} type="image/webp" />
      <img
        src={u('/pics/9af15841-4cc0-4c87-8725-72c2e3d98189.png')}
        alt=""
        width="1536"
        height="1024"
        class="h-full w-full scale-105 object-cover object-center opacity-[.62]"
        fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_55%_at_50%_45%,transparent,rgba(20,16,12,.8)_78%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950/80 via-ink-950/38 to-ink-950/94"></div>

    <!-- the gold rule that frames a manuscript page -->
    <div class="pointer-events-none absolute inset-5 border border-gold-600/22 sm:inset-8"></div>
    <div class="pointer-events-none absolute inset-[26px] border border-gold-600/12 sm:inset-[42px]"></div>

    <div class="relative mx-auto max-w-3xl px-6 py-24 text-center">
      <div class="flex justify-center" data-reveal>
        <MeskelCross
          size={132}
          stroke="var(--color-gold-400)"
          accent="var(--color-madder-500)"
          animate
          class="drop-shadow-[0_0_28px_rgba(212,167,65,.35)]"
          title="Ethiopian processional cross"
        />
      </div>

      <p class="rubric mt-8 !text-gold-400/85" data-reveal style="--reveal-delay:120ms">
        Ethiopian Orthodox Tewahedo Church
      </p>

      <h1 class="geez mt-5 text-[clamp(2rem,7vw,4.15rem)] leading-[1.14] font-600 gilt gilt-shimmer"
          data-reveal style="--reveal-delay:220ms">
        ሐመረ ኖኅ<br />ኪዳነ ምሕረት
      </h1>

      <p class="mt-5 font-display text-[clamp(1.05rem,2.6vw,1.6rem)] tracking-[.06em] text-vellum-100"
         data-reveal style="--reveal-delay:320ms">
        Hamere Noah Kidane Mihret
      </p>

      <p class="mx-auto mt-7 max-w-xl text-[1.06rem] leading-relaxed text-vellum-200/72"
         data-reveal style="--reveal-delay:420ms">
        The Ark that carried Noah through the flood, and the Covenant of Mercy given to
        Our Lady — the two names this parish in {PARISH.city} was given, and the two
        things it is here to do.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4"
           data-reveal style="--reveal-delay:520ms">
        <a href={u('/services')}
           class="border border-gold-500 bg-gold-500 px-7 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-gold-400 hover:border-gold-400">
          Service Times
        </a>
        <a href={u('/visit')}
           class="border border-vellum-200/35 px-7 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-vellum-100 uppercase transition-colors duration-300 hover:border-gold-400 hover:text-gold-300">
          Plan a Visit
        </a>
      </div>

      <p class="mt-9 font-ui text-[.78rem] tracking-[.05em] text-vellum-200/58"
         data-reveal style="--reveal-delay:620ms">
        {PARISH.address.street}, {PARISH.city} · Kidase begins {sunday.from}
        <span class="geez">&#8202;({ethiopianClockOf(sunday.from).text})</span>
      </p>
    </div>

    <!-- the plaited band that closes the page, as at the foot of a folio -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0">
      <div class="h-px bg-gradient-to-r from-transparent via-gold-500/55 to-transparent"></div>
      <div class="opacity-55">
        <Harag variant="plait" repeat={26} height={30} mono color="var(--color-gold-500)" />
      </div>
    </div>
  </section>

  <TodayStrip />

  <!-- ══════════════════════════ THE NAME ══════════════════════════ -->
  <section id="name" class="relative overflow-hidden border-b border-[var(--rule)] bg-vellum-50">
    <div class="absolute inset-0 opacity-35" aria-hidden="true"
         style="background-image:radial-gradient(circle at 1px 1px,rgba(110,78,18,.18) 1px,transparent 0);background-size:18px 18px"></div>
    <div class="absolute inset-x-0 top-0 opacity-55"><Harag variant="plait" repeat={24} height={28} /></div>
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src={u('/pics/angels winged cherub faces-Photoroom.png')}
        alt=""
        class="absolute top-9 -left-8 w-32 -rotate-6 opacity-[.13] mix-blend-multiply sm:top-8 sm:-left-6 sm:w-48 lg:-top-2 lg:left-1 lg:w-72 lg:opacity-[.15]"
        loading="lazy"
      />
      <img
        src={u('/pics/angels winged cherub faces-Photoroom.png')}
        alt=""
        class="absolute top-9 -right-8 w-32 rotate-6 opacity-[.13] mix-blend-multiply sm:top-8 sm:-right-6 sm:w-48 lg:-top-2 lg:right-1 lg:w-72 lg:opacity-[.15]"
        loading="lazy"
      />
      <img
        src={u('/pics/angels winged cherub faces-Photoroom.png')}
        alt=""
        class="absolute bottom-8 -left-8 w-28 rotate-6 opacity-[.11] mix-blend-multiply sm:bottom-10 sm:-left-5 sm:w-44 lg:bottom-7 lg:left-2 lg:w-64 lg:opacity-[.13]"
        loading="lazy"
      />
      <img
        src={u('/pics/angels winged cherub faces-Photoroom.png')}
        alt=""
        class="absolute right-[-2rem] bottom-8 w-28 -rotate-6 opacity-[.11] mix-blend-multiply sm:right-[-1.25rem] sm:bottom-10 sm:w-44 lg:right-2 lg:bottom-7 lg:w-64 lg:opacity-[.13]"
        loading="lazy"
      />
    </div>

    <div class="relative z-10 mx-auto max-w-[1240px] px-5 py-20 lg:px-8 lg:py-28">
      <header class="relative z-10 mb-10 max-w-2xl pr-20 sm:pr-32 lg:pr-0">
        <p class="rubric">The meaning we carry · ስያሜያችን</p>
        <h2 class="mt-4 text-[clamp(1.9rem,4vw,2.9rem)]">Two names. One calling.</h2>
        <p class="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-ink-600">
          Our name is more than an inscription above a door. It tells the story of a
          vessel that carries life—and a promise that mercy will meet us there.
        </p>
      </header>

      <div class="grid overflow-hidden border border-gold-700/30 bg-vellum-100 shadow-lifted lg:grid-cols-[.92fr_1.08fr] lg:grid-rows-2">
        {NAME_MEANING.map((n, i) => (
          <article class:list={[
            'relative flex min-h-[21rem] flex-col justify-center p-8 sm:p-10 lg:p-12',
            i === 0 ? 'border-b border-[var(--rule)]' : '',
          ]} data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <span class="geez absolute top-7 right-8 text-[2.1rem] leading-none text-gold-700/24 select-none" aria-hidden="true">
              {toGeez(i + 1)}
            </span>
            <p class="geez text-[clamp(2.15rem,5vw,3.15rem)] leading-tight text-madder-800">{n.geez}</p>
            <p class="mt-3 font-display text-[1.18rem] tracking-[.08em] text-gold-800 uppercase">{n.tr}</p>
            <p class="mt-1 text-[1.02rem] italic text-ink-600">“{n.en}”</p>
            <div class="my-5 h-px w-24 bg-gold-700/45"></div>
            <p class="max-w-[54ch] text-[1.02rem] leading-[1.72] text-ink-700">{n.body}</p>
          </article>
        ))}

        <figure class="group relative min-h-[36rem] overflow-hidden border-t border-gold-700/30 lg:row-span-2 lg:row-start-1 lg:col-start-2 lg:min-h-0 lg:border-t-0 lg:border-l" data-reveal style="--reveal-delay:140ms">
          <img
            src={u('/pics/kidane_meheret-new.jpg')}
            alt="Ethiopian icon of the Kidane Mihret, the Covenant of Mercy, showing Christ and the Father crowning the Virgin Mary"
            class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-1000 group-hover:scale-[1.025]"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
          <figcaption class="absolute inset-x-0 bottom-0 p-7 text-vellum-50 sm:p-9">
            <span class="geez block text-[1.45rem] text-gold-300">ኪዳነ ምሕረት</span>
            <span class="mt-1 block font-ui text-[.7rem] tracking-[.2em] text-vellum-100/78 uppercase">The Covenant of Mercy</span>
          </figcaption>
        </figure>
      </div>

      <p class="mx-auto mt-10 max-w-2xl text-center font-display text-[1.08rem] leading-relaxed text-madder-800" data-reveal>
        Kept especially on {PARISH.patron.feastEth}
        <span class="geez text-gold-700">&#8202;({PARISH.patron.feastGeez})</span>, and remembered on the sixteenth of every month.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════ OUR STORY ══════════════════════════ -->
  <section class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-[.94fr_1.06fr] lg:gap-20">
      <div class="relative mx-auto w-full max-w-[34rem] lg:mx-0" data-reveal>
        <div class="absolute -top-4 -left-4 h-full w-full border border-gold-700/38" aria-hidden="true"></div>
        <figure class="relative overflow-hidden bg-ink-900 p-2 shadow-lifted">
          <img
            src={u('/pics/church1.png')}
            alt="The painted interior and central aisle of Hamere Noah Kidane Mihret Church in Sioux Falls"
            class="aspect-[4/5] w-full object-cover object-center"
            loading="lazy"
          />
          <figcaption class="flex items-center justify-between gap-4 px-3 py-3 text-vellum-200/72">
            <span class="text-[.78rem] leading-snug">Hamere Noah Kidane Mihret, Sioux Falls</span>
            <span class="font-ui text-[.58rem] tracking-[.12em] text-gold-400/75 uppercase">Our parish home</span>
          </figcaption>
        </figure>
        <div class="absolute -right-4 -bottom-5 bg-madder-800 px-5 py-4 text-vellum-50 shadow-panel sm:-right-7 sm:px-6">
          <span class="block font-ui text-[.6rem] tracking-[.18em] text-gold-300 uppercase">A home of prayer</span>
          <span class="mt-1 block font-display text-[1.1rem]">West 11th Street</span>
        </div>
      </div>

      <div data-reveal style="--reveal-delay:120ms">
        <p class="rubric">Our parish story · የደብሩ ታሪክ</p>
        <h2 class="mt-4 text-[clamp(1.9rem,4vw,2.9rem)]">
          The people arrived first.<br />The church took root.
        </h2>
        <div class="reading mt-7 text-[1.07rem] leading-[1.75] text-ink-700">
          <p class="dropcap">
            Before Hamere Noah Kidane Mihret had an address on West 11th Street, it had
            a people: families carrying an ancient faith into a new city, gathering to
            pray, and making a place where the next generation could belong.
          </p>
          <p>
            The liturgy followed them to Sioux Falls. A congregation formed around the
            tabot, the songs of St Yared, shared meals, and the steady work of building
            community. What stands here now is more than a building—it is a spiritual
            home carried across distance and planted with care.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-3 border-y border-[var(--rule)] py-5">
          <div>
            <span class="geez block text-[1.15rem] text-madder-800">ጥንታዊ</span>
            <span class="font-ui text-[.62rem] tracking-[.12em] text-ink-500 uppercase">Ancient faith</span>
          </div>
          <div class="border-x border-[var(--rule)] px-5">
            <span class="block font-display text-[1rem] text-madder-800">Sioux Falls</span>
            <span class="font-ui text-[.62rem] tracking-[.12em] text-ink-500 uppercase">New roots</span>
          </div>
          <div class="pl-5">
            <span class="geez block text-[1.15rem] text-madder-800">አንድነት</span>
            <span class="font-ui text-[.62rem] tracking-[.12em] text-ink-500 uppercase">One family</span>
          </div>
        </div>

        <a href={u('/about')}
           class="group mt-9 inline-flex items-center gap-3 border border-madder-800 bg-madder-800 px-7 py-3.5 font-ui text-[.76rem] tracking-[.14em] text-vellum-50 uppercase transition-colors duration-300 hover:bg-transparent hover:text-madder-800">
          Read our full story
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ ANGELIC BAND ══════════════════════════ -->
  <div
    class="relative isolate h-32 overflow-hidden border-y border-gold-600/45 bg-ink-950 sm:h-40 lg:h-52"
    role="separator"
    aria-label="Ethiopian church cherub artwork"
  >
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(192,145,46,.18),transparent_68%)]" aria-hidden="true"></div>
    <img
      src={u('/pics/image-Photoroom (25).png')}
      alt=""
      aria-hidden="true"
      class="absolute top-1/2 left-1/2 w-[155%] max-w-none -translate-x-1/2 -translate-y-1/2 object-cover object-center sm:w-[135%] lg:inset-0 lg:h-full lg:w-full lg:translate-x-0 lg:translate-y-0"
      loading="lazy"
    />
    <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-ink-950 to-transparent sm:w-32" aria-hidden="true"></div>
    <div class="absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-ink-950 to-transparent sm:w-32" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-300/75 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-madder-500/80 to-transparent" aria-hidden="true"></div>
  </div>

  <!-- The newest non-draft Markdown entry is featured automatically. -->
  {latestParishUpdate && <ParishNoticeboard update={latestParishUpdate} />}

  <!-- ══════════════════════════ SUNDAY MORNING ══════════════════════════ -->
  <section id="sunday-order" class="relative overflow-hidden border-b border-[var(--rule)] bg-vellum-100/70">
    <div class="absolute inset-x-0 top-0 opacity-40"><Harag variant="vine" repeat={22} height={24} /></div>

    <div class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-28">
      <div class="grid gap-14 lg:grid-cols-[.9fr_1.1fr] lg:gap-20">
        <div data-reveal>
          <p class="rubric">Sunday morning · እሑድ ጠዋት</p>
          <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">What happens, in order</h2>
          <p class="mt-6 text-[1.05rem] leading-relaxed text-ink-600">
            A full Sunday runs four and a half hours and is really five services joined
            end to end. Knowing the shape of it makes the whole thing far easier to
            follow—and tells you when to arrive if you cannot manage all of it.
          </p>
          <a href={u('/services')}
             class="group mt-7 inline-flex items-center gap-3 font-ui text-[.74rem] tracking-[.14em] text-madder-800 uppercase">
            See times & prepare your visit
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </a>
          <div class="mt-8">
            <ArchFrame
              src={u('/pics/inside church.jpg')}
              alt="The sanctuary inside Hamere Noah Kidane Mihret Church in Sioux Falls"
              ratio="4 / 3"
              position="center 42%"
              caption="Inside our sanctuary, the order of Sunday worship moves toward the altar at the heart of the church."
            />
          </div>
        </div>

        <ol class="border-t border-[var(--rule)]">
          {KIDASE_ORDER.map((k, i) => (
            <li class="grid grid-cols-[2.6rem_1fr] gap-x-5 border-b border-[var(--rule)] py-6"
                data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="geez pt-1 text-[1.2rem] leading-none text-gold-600">{toGeez(i + 1)}</span>
              <div>
                <p class="geez text-[1.3rem] leading-tight text-madder-900">{k.geez}</p>
                <p class="mt-1 flex flex-wrap items-baseline gap-x-3">
                  <span class="font-display text-[1.08rem] text-ink-800">{k.en}</span>
                  <span class="font-ui text-[.7rem] tracking-[.14em] text-gold-700 uppercase">{k.tr}</span>
                </p>
                <p class="mt-2 text-[.98rem] leading-relaxed text-ink-600">{k.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ FEASTS ══════════════════════════ -->
  <section class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div data-reveal>
        <p class="rubric">Bahire Hasab · ባሕረ ሐሳብ</p>
        <h2 class="mt-4 text-[clamp(1.85rem,4vw,2.7rem)]">What is coming</h2>
        <p class="mt-6 text-[1.04rem] leading-relaxed text-ink-600">
          The dates below are not typed into a spreadsheet. They are computed the way the
          Church computes them — the Paschalion fixes Fasika, and every movable feast and
          fast is measured out from it in days.
        </p>
        <a href={u('/calendar')}
           class="group mt-8 inline-flex items-center gap-3 font-ui text-[.82rem] tracking-[.12em] text-madder-800 uppercase">
          The whole year
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
        </a>
      </div>

      <ul class="border-t border-[var(--rule)]">
        {feasts.map((f, i) => (
          <li class="group flex items-baseline gap-5 border-b border-[var(--rule)] py-5 transition-colors duration-300 hover:bg-gold-200/25 sm:gap-8"
              data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <div class="w-[4.5rem] shrink-0 text-center">
              <span class="block font-display text-[1.55rem] leading-none text-madder-800">
                {f.date.getDate()}
              </span>
              <span class="block font-ui text-[.66rem] tracking-[.16em] text-gold-700 uppercase">
                {f.date.toLocaleDateString('en-US', { month: 'short' })}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="geez text-[1.12rem] leading-tight text-madder-900">{f.geez}</p>
              <p class="mt-1 font-display text-[1rem] text-ink-700">{f.tr} — {f.en}</p>
              {f.note && <p class="mt-1.5 text-[.9rem] leading-relaxed text-ink-600">{f.note}</p>}
            </div>
            <span class:list={[
              'shrink-0 border px-2.5 py-1 font-ui text-[.62rem] tracking-[.14em] uppercase',
              f.kind === 'patronal' ? 'border-madder-700 bg-madder-800 text-vellum-50'
              : f.kind.startsWith('fast') ? 'border-malachite-700/45 text-malachite-800'
              : 'border-gold-600/50 text-gold-800',
            ]}>
              {f.kind === 'patronal' ? 'Our feast' : f.kind.startsWith('fast') ? 'Fast' : 'Feast'}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Divider class="my-4" />

  <!-- ══════════════════════════ ART ══════════════════════════ -->
  <section class="mx-auto max-w-[1240px] px-5 py-20 lg:px-8 lg:py-24">
    <div class="mx-auto mb-14 max-w-2xl text-center" data-reveal>
      <p class="rubric">Sacred art · ሥዕለ አድኅኖ</p>
      <h2 class="mt-4 text-[clamp(1.85rem,4vw,2.7rem)]">Painted so that it can be read</h2>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-600">
        Ethiopian painters will distort a proportion without hesitation if it makes the
        meaning clearer. The eyes are large because the saints are watching; the
        righteous face you and the wicked are shown in profile. Clarity first, and
        beauty follows from it.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { src: u('/art/ceiling-angels.jpg'), alt: 'The painted ceiling of winged cherub faces at Debre Berhan Selassie, Gondar', cap: 'A hundred and thirty-five winged faces on one ceiling at Gondar.', cr: 'Rod Waddington · CC BY-SA 2.0' },
        { src: u('/art/manuscript-18c.jpg'), alt: 'An open Ethiopian codex showing Adam and Eve at the tree, with Ge’ez text', cap: 'The Fall, painted between two blocks of Ge’ez.', cr: 'Public domain' },
        { src: u('/art/cross-walters.jpg'), alt: 'Ethiopian processional cross', cap: 'A processional cross, pierced and interlaced.', cr: 'Walters Art Museum · Public domain' },
        { src: u('/art/ura-painting.jpg'), alt: 'Wall painting at Ura Kidane Mehret on Lake Tana', cap: 'Wall painting at Ura Kidane Mehret, Lake Tana.', cr: 'Bernard Gagnon · CC BY-SA 3.0' },
      ].map((a, i) => (
        <div data-reveal style={`--reveal-delay:${i * 110}ms`}>
          <ArchFrame src={a.src} alt={a.alt} ratio="3 / 4" caption={a.cap} credit={a.cr} />
        </div>
      ))}
    </div>

    <div class="mt-14 text-center" data-reveal>
      <a href={u('/gallery')}
         class="group inline-flex items-center gap-3 border border-madder-800 px-8 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-madder-800 uppercase transition-colors duration-300 hover:bg-madder-800 hover:text-vellum-50">
        Enter the gallery
        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
      </a>
    </div>
  </section>

