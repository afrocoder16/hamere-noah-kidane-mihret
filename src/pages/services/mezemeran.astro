---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { PARISH } from '../../lib/parish';
import { u } from '../../lib/url';
const photos = [
  { src: '/pics/Mahlet.jpg', alt: 'Mahlet singers gathered with prayer staffs inside the church' },
  { src: '/pics/Mahlet2.jpg', alt: 'The Mahlet group standing together before the sanctuary' },
  { src: '/pics/Mahlet3.jpg', alt: 'Parish singers participating in Mahlet' },
  { src: '/pics/Mahlet4.jpg', alt: 'The Mahlet choir during worship' },
];
---
<Base title="Mezemeran" description="Learn about the Mezemeran, the singers and chanters who carry Ethiopian Orthodox sacred hymnody.">
  <PageHeader eyebrow="Services · Mezemeran" geez="መዘምራን" title="The prayer carried in song" lede="The Church's sacred music is prayer: learned together, offered together, and carried from one generation to the next." image={u('/pics/Mahlet.jpg')} imageAlt="Mezemeran gathered for prayer and chant" />

  <section class="mx-auto grid max-w-[1240px] gap-14 px-5 py-20 lg:grid-cols-[.9fr_1.1fr] lg:px-8 lg:py-28">
    <div data-reveal>
      <p class="rubric">Mezemeran · መዘምራን</p>
      <h2 class="mt-4 text-[clamp(1.8rem,4vw,2.55rem)]">A ministry of worship</h2>
      <div class="reading mt-7 text-[1.04rem] leading-[1.8] text-ink-700">
        <p>Mezemeran are gospel singers and chanters who serve the worship of the Ethiopian Orthodox Tewahedo Church. Their singing carries hymns, responses, and praise through the liturgical year.</p>
        <p>The Church's zema tradition is associated with Saint Yared and is transmitted through attentive practice and memorization. Singers learn with experienced teachers, keeping the melody, words, rhythm, and movement of each service together.</p>
        <p>In parish life, this ministry belongs to the whole community: singers prepare, serve during worship, and help young people learn the songs.</p>
      </div>
      <a href={PARISH.phoneHref} class="mt-7 inline-flex border border-madder-800 px-6 py-3 font-ui text-[.7rem] tracking-[.14em] text-madder-800 uppercase transition hover:bg-madder-800 hover:text-vellum-50">Ask about joining</a>
    </div>
    <figure data-reveal style="--reveal-delay:120ms">
      <img src={u('/art/saint-yared.jpg')} alt="Traditional Ethiopian painting of Saint Yared singing before Emperor Gebre Meskel" class="w-full border border-gold-700/30 object-cover shadow-lifted" loading="lazy" />
      <figcaption class="mt-3 text-center font-ui text-[.62rem] tracking-[.12em] text-gold-800 uppercase">Saint Yared and the tradition of zema · Public domain</figcaption>
    </figure>
  </section>

  <section class="border-y border-[var(--rule)] bg-vellum-100/70">
    <div class="mx-auto max-w-[1240px] px-5 py-16 lg:px-8 lg:py-20">
      <div class="mx-auto mb-10 max-w-2xl text-center"><p class="rubric">The singers of our parish</p><h2 class="mt-3 text-[1.8rem]">Learning and serving together</h2></div>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">{photos.map((photo) => <img src={u(photo.src)} alt={photo.alt} class="aspect-square w-full border border-gold-700/25 object-cover" loading="lazy" />)}</div>
      <p class="mx-auto mt-7 max-w-2xl text-center text-[.96rem] leading-relaxed text-ink-600">Interested in singing or learning the chants? Contact the parish to ask about rehearsals, instruction, and feast-day service.</p>
    </div>
  </section>
</Base>
