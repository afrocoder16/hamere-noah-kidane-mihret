---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Divider from '../components/ornament/Divider.astro';
import { PARISH } from '../lib/parish';
import { u } from '../lib/url';

const TIMELINE = [
  {
    when: 'Acts 8',
    geez: 'ጃንደረባው',
    head: 'An Ethiopian receives the Gospel',
    body:
      'The Acts of the Apostles records Philip meeting an Ethiopian court official who ' +
      'was reading Isaiah. Philip proclaimed Christ to him and baptised him on the road ' +
      'from Jerusalem to Gaza—an early biblical witness cherished by Ethiopian Christians.',
  },
  {
    when: '4th c.',
    geez: 'ፍሬምናጦስ',
    head: 'Frumentius and King Ezana',
    body:
      'St Frumentius was consecrated by St Athanasius of Alexandria as the first bishop ' +
      'of the Ethiopian Church. Christianity took root in the Aksumite kingdom during ' +
      'the reign of King Ezana.',
  },
  {
    when: '5th–6th c.',
    geez: 'ተስዓቱ ቅዱሳን',
    head: 'The Nine Saints',
    body:
      'The Nine Saints strengthened monastic life, teaching, and the translation of the ' +
      'Scriptures and other Christian works into Ge’ez, helping the faith spread beyond Aksum.',
  },
  {
    when: '6th c.',
    geez: 'ቅዱስ ያሬድ',
    head: 'The sacred music of St Yared',
    body:
      'Ethiopian tradition honours St Yared as the father of its sacred music. The ' +
      'three modes associated with his work continue to shape the Church’s liturgical chant.',
  },
  {
    when: '12th–13th c.',
    geez: 'ላሊበላ',
    head: 'The churches hewn at Lalibela',
    body:
      'The rock-hewn churches of Lalibela remain an enduring witness to Ethiopian ' +
      'Christian worship, architecture, pilgrimage, and devotion.',
  },
  {
    when: '1959',
    geez: 'ራስ ገዝ',
    head: 'Autocephaly',
    body:
      'The installation of Abuna Basilios as the first Patriarch of Ethiopia completed ' +
      'the Ethiopian Orthodox Tewahedo Church’s path to full self-government.',
  },
  {
    when: 'Today',
    geez: 'ሲዩክስ ፎልስ',
    head: 'The faith lived in Sioux Falls',
    body:
      `Hamere Noah Kidane Mihret now gathers at ${PARISH.address.street}. Here the parish ` +
      'continues the worship and sacramental life of the Ethiopian Orthodox Tewahedo Church.',
  },
];
---

<Base
  title="About"
  description="About Hamere Noah Kidane Mihret Ethiopian Orthodox Tewahedo Church in Sioux Falls, its parish life, clergy, and faith."
>
  <PageHeader
    eyebrow="About us · ስለ እኛ"
    geez="ስለ ቤተ ክርስቲያናችን"
    title="Ancient faith, a living parish"
    lede="An Ethiopian Orthodox Tewahedo parish serving the faithful in Sioux Falls, South Dakota."
    image={u('/art/bete-giyorgis.jpg')}
    imageAlt=""
  />

  <!-- ══════════ opening ══════════ -->
  <section id="parish" class="mx-auto max-w-[1240px] px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid items-center gap-14 lg:grid-cols-[.92fr_1.08fr] lg:gap-20">
      <div data-reveal>
        <p class="rubric">The parish · ደብሩ</p>
        <h2 class="mt-4 text-[clamp(1.9rem,4.2vw,3rem)]">A home for worship, mercy, and belonging</h2>
        <div class="reading mt-7 text-[1.06rem] leading-[1.75] text-ink-700">
          <p class="dropcap">
            Hamere Noah Kidane Mihret is an Ethiopian Orthodox Tewahedo parish in
            {' '}{PARISH.city}, {PARISH.state}. The parish gathers around the Divine Liturgy,
            the sacramental life of the Church, prayer, teaching, and fellowship.
          </p>
          <p>
            Its name holds two images dear to the parish: Hamere Noah, the Ark of Noah,
            and Kidane Mihret, the Covenant of Mercy. Together they speak of the Church
            as a place of refuge in Christ and of the mercy of God remembered in the
            Church’s devotion to the Mother of God.
          </p>
          <p>
            At {PARISH.address.street}, parish life is shared across generations. The
            faithful come together to worship, children learn the tradition, families keep
            feast days, and the community cares for one another through both joyful and
            difficult seasons. The building is the parish’s visible home; the life within it
            is formed by common prayer and faithful service.
          </p>
        </div>
      </div>

      <figure class="relative mx-auto w-full max-w-[35rem]" data-reveal style="--reveal-delay:140ms">
        <div class="absolute -inset-4 border border-gold-700/32 sm:-inset-6" aria-hidden="true"></div>
        <div class="relative bg-ink-950 p-2.5 shadow-lifted sm:p-3">
          <picture>
            <source srcset={u('/pics/church1.webp')} type="image/webp" />
            <img
              src={u('/pics/church1.png')}
              alt="The nave and sanctuary of Hamere Noah Kidane Mihret Church in Sioux Falls"
              width="1086"
              height="1448"
              class="h-auto w-full"
              loading="eager"
            />
          </picture>
          <figcaption class="flex flex-col gap-1 px-3 py-4 text-vellum-100 sm:flex-row sm:items-center sm:justify-between sm:px-4">
            <span class="font-display text-[.86rem]">Our parish church</span>
            <span class="font-ui text-[.58rem] tracking-[.14em] text-gold-400/80 uppercase">Sioux Falls · South Dakota</span>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>

  <!-- ══════════════════════════ OUR SPIRITUAL FATHERS ══════════════════════════ -->
  <section id="clergy" class="relative overflow-hidden border-y border-[var(--rule-gold)] bg-vellum-100/72">
    <div class="absolute inset-0 opacity-30" aria-hidden="true"
         style="background-image:radial-gradient(circle at 1px 1px,rgba(110,78,18,.16) 1px,transparent 0);background-size:20px 20px"></div>
    <div class="absolute top-0 left-1/2 h-px w-[min(78rem,88vw)] -translate-x-1/2 bg-gradient-to-r from-transparent via-gold-700/45 to-transparent" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-32">
      <header class="grid gap-8 lg:grid-cols-[.78fr_1.22fr] lg:gap-20" data-reveal>
        <div>
          <p class="rubric">Our spiritual fathers · መንፈሳዊ አባቶቻችን</p>
          <h2 class="mt-4 text-[clamp(2rem,4.6vw,3.35rem)]">A ministry entrusted to service</h2>
        </div>
        <div class="grid gap-5 text-[1.05rem] leading-[1.78] text-ink-700 sm:grid-cols-2">
          <p>
            In the Ethiopian Orthodox Tewahedo Church, ordained authority is understood as
            <em>diakonia</em>—service. Priests are entrusted with the sacramental life of the
            parish and with teaching and preaching the faith received by the Church.
          </p>
          <p>
            Deacons assist the bishop and priests in worship, proclaim the Scriptures, and
            help preserve good order. Clergy and faithful serve together as one body, sharing
            responsibility for the prayer, unity, and care of the parish.
          </p>
        </div>
      </header>

      <div class="relative mt-20 grid gap-10 md:grid-cols-3 md:gap-6 lg:mt-24 lg:gap-9">
        <div class="absolute top-16 right-0 left-0 hidden h-px bg-gold-700/30 md:block" aria-hidden="true"></div>
        {[
          {
            image: '/pics/church-father2.jpg',
            alt: 'A priest of Hamere Noah Kidane Mihret wearing liturgical vestments',
            className: 'md:mt-10',
          },
          {
            image: '/pics/main-church-father.jpg',
            alt: 'A priest of Hamere Noah Kidane Mihret holding an Ethiopian hand cross',
            className: '',
          },
          {
            image: '/pics/church-father3.jpg',
            alt: 'A member of the clergy of Hamere Noah Kidane Mihret holding a cross',
            className: 'md:mt-10',
          },
        ].map((father, i) => (
          <figure class={`group relative ${father.className}`} data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <div class="relative border border-gold-700/30 bg-vellum-50 p-2.5 shadow-lifted sm:p-3">
              <div class="overflow-hidden bg-ink-950">
                <img
                  src={u(father.image)}
                  alt={father.alt}
                  width="960"
                  height="1280"
                  class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.012]"
                  loading="lazy"
                />
              </div>
              <figcaption class="flex items-center justify-between gap-4 px-2 pt-4 pb-2 sm:px-3 sm:pt-5 sm:pb-3">
                <span class="font-display text-[.9rem] text-madder-900">Parish clergy</span>
                <span class="geez text-[.74rem] text-gold-800">የደብሩ ካህናት</span>
              </figcaption>
            </div>
          </figure>
        ))}
      </div>

      <blockquote class="mx-auto mt-20 grid max-w-4xl items-center gap-5 border-y border-gold-700/35 py-7 text-center sm:grid-cols-[1fr_auto_1fr] sm:text-left" data-reveal>
        <p class="font-display text-[clamp(1.2rem,2.4vw,1.55rem)] leading-snug text-madder-900">
          “Shepherd the flock of God which is among you.”
        </p>
        <span class="hidden h-10 w-px bg-gold-700/35 sm:block" aria-hidden="true"></span>
        <cite class="font-ui text-[.66rem] tracking-[.18em] text-gold-800 not-italic uppercase sm:text-right">
          1 Peter 5:2 · ፩ ጴጥሮስ ፭፥፪
        </cite>
      </blockquote>
    </div>
  </section>

  <!-- ══════════ timeline ══════════ -->
  <section class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-32">
    <div class="mx-auto mb-16 max-w-2xl text-center" data-reveal>
      <p class="rubric">How we got here · ታሪክ</p>
      <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">A faith carried through the centuries</h2>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-600">
        Selected moments from the history and living tradition of the Ethiopian Orthodox
        Tewahedo Church, leading to a parish worshipping today in South Dakota.
      </p>
    </div>

    <ol class="relative mx-auto max-w-3xl">
      <!-- the rule the whole story hangs from -->
      <div class="absolute top-2 bottom-2 left-[calc(6rem+1px)] hidden w-px bg-[var(--rule-gold)] sm:block"></div>

      {TIMELINE.map((t, i) => (
        <li class="relative grid gap-x-8 gap-y-2 pb-11 last:pb-0 sm:grid-cols-[6rem_1fr]"
            data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <div class="sm:text-right">
            <span class="font-display text-[1.05rem] whitespace-nowrap text-madder-800">{t.when}</span>
          </div>
          <div class="relative sm:pl-8">
            <span class="absolute top-2 -left-[5px] hidden h-[9px] w-[9px] rotate-45 border border-gold-700 bg-vellum sm:block"></span>
            <p class="geez text-[1.05rem] leading-tight text-gold-700">{t.geez}</p>
            <h3 class="mt-1 font-display text-[1.2rem] text-madder-900">{t.head}</h3>
            <p class="mt-2 text-[1rem] leading-relaxed text-ink-700">{t.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <Divider />

  <!-- ══════════ tewahedo ══════════ -->
  <section class="relative overflow-hidden border-y border-[var(--rule-gold)] bg-vellum-50">
    <div
      class="absolute inset-0 opacity-35"
      aria-hidden="true"
      style="background-image:radial-gradient(circle at 1px 1px,rgba(110,78,18,.14) 1px,transparent 0);background-size:22px 22px"
    ></div>
    <div class="geez pointer-events-none absolute top-8 -right-8 hidden text-[11rem] leading-none text-gold-700/[.055] select-none xl:block" aria-hidden="true">
      ተዋሕዶ
    </div>

    <div class="relative mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-32">
      <div class="grid items-end gap-10 lg:grid-cols-[.86fr_1.14fr] lg:gap-20">
        <header data-reveal>
          <p class="rubric">The word itself · ተዋሕዶ</p>
          <h2 class="geez mt-5 text-[clamp(3.4rem,8vw,6.7rem)] leading-[.9] text-madder-900">
            ተዋሕዶ
          </h2>
          <p class="mt-5 font-display text-[clamp(1.35rem,2.6vw,1.85rem)] tracking-wide text-ink-800">
            Tewahedo — “made one”
          </p>
        </header>

        <div class="relative border-l-2 border-madder-800 pl-6 sm:pl-9" data-reveal style="--reveal-delay:120ms">
          <p class="text-[1.08rem] leading-[1.85] text-ink-700">
            Tewahedo is a Ge’ez word meaning “being made one.” It confesses that in the one
            incarnate Lord Jesus Christ, divinity and humanity are united without mixture,
            confusion, division, or separation. He is fully God and fully human, one Lord and
            Saviour.
          </p>
          <a
            href={u('/faith')}
            class="group mt-7 inline-flex items-center gap-3 font-ui text-[.76rem] tracking-[.14em] text-madder-800 uppercase"
          >
            What we believe
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </a>
        </div>
      </div>

      <div class="mt-16 border border-gold-700/30 bg-vellum-100/80 p-2.5 shadow-lifted sm:p-3 lg:mt-20" data-reveal>
        <div class="grid gap-2.5 lg:grid-cols-12 lg:gap-3">
          <figure class="group relative overflow-hidden bg-ink-950 lg:col-span-7 lg:row-span-2">
            <img
              src={u('/pics/church-pic3.jpg')}
              alt="Clergy and faithful taking part in an outdoor church procession"
              width="2048"
              height="1365"
              class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.012]"
              loading="lazy"
            />
          </figure>

          <figure class="group relative overflow-hidden bg-ink-950 lg:col-span-5">
            <img
              src={u('/pics/church-pic.jpg')}
              alt="Clergy and faithful gathered during a church service"
              width="2000"
              height="924"
              class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.012]"
              loading="lazy"
            />
          </figure>

          <figure class="group relative overflow-hidden bg-ink-950 lg:col-span-5">
            <img
              src={u('/pics/church-pic2.jpg')}
              alt="The congregation gathered for worship beneath an Ethiopian flag"
              width="2000"
              height="924"
              class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.012]"
              loading="lazy"
            />
          </figure>
        </div>

        <div class="mt-2.5 grid gap-2.5 sm:grid-cols-2 lg:mt-3 lg:gap-3">
          <figure class="group relative overflow-hidden bg-ink-950">
            <img
              src={u('/pics/church-pic4.jpg')}
              alt="Clergy, young people, and parishioners gathered before the sanctuary"
              width="2048"
              height="1365"
              class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.012]"
              loading="lazy"
            />
          </figure>

          <figure class="group relative overflow-hidden bg-ink-950">
            <img
              src={u('/pics/church-pic5.jpg')}
              alt="The parish community gathered before the painted sanctuary"
              width="2048"
              height="1365"
              class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.012]"
              loading="lazy"
            />
          </figure>
        </div>

        <div class="grid divide-y divide-gold-700/25 px-3 py-5 text-center sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-0 sm:py-6">
          <p class="py-2 font-ui text-[.65rem] tracking-[.16em] text-gold-900 uppercase sm:py-0">One incarnate Lord</p>
          <p class="py-2 font-ui text-[.65rem] tracking-[.16em] text-gold-900 uppercase sm:py-0">Fully God</p>
          <p class="py-2 font-ui text-[.65rem] tracking-[.16em] text-gold-900 uppercase sm:py-0">Fully human</p>
        </div>
      </div>
    </div>
  </section>
</Base>
