---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TodayStrip from '../components/TodayStrip.astro';
import ArchFrame from '../components/ornament/ArchFrame.astro';
import Divider from '../components/ornament/Divider.astro';
import Harag from '../components/ornament/Harag.astro';
import { KIDASE_ORDER, PARISH, SERVICES } from '../lib/parish';
import { ethiopianClockOf, toGeez } from '../lib/ethiopic';
import { u } from '../lib/url';

const EXPECT = [
  { q: 'What time should I come?',
    a: 'The service begins at 6:00 AM and the Liturgy proper is around 8:00. Almost nobody stays for the whole thing every week. Coming at 8:00 is entirely normal and no one will think anything of it.' },
  { q: 'What do I wear?',
    a: 'Modest and covering — long sleeves, and a skirt or trousers past the knee. Women cover their hair with a white shawl (netela); if you do not have one, bring a scarf, and someone will very likely offer you one at the door.' },
  { q: 'Do I have to take my shoes off?',
    a: 'Yes. Everyone does, at the door — the ground of a church is holy ground, as it was at the burning bush. There is a rack for them.' },
  { q: 'Where do I stand?',
    a: 'Men on one side, women on the other, and everyone standing. There are some seats along the wall for the elderly and for those who need them. Standing at the back is perfectly correct for a first visit.' },
  { q: 'Can I receive Communion?',
    a: 'Communion is for baptised Orthodox Christians who have kept the fast and been to confession. If you are not, you are still entirely welcome to be present — and at the end of the service everyone receives blessed bread, which is not the Eucharist and is for all.' },
  { q: 'Will I understand any of it?',
    a: 'The liturgy is in Ge’ez, which is nobody’s first language; the sermon is in Amharic. So: probably not, not at first. That is true for a great many people in the room, including some who have been coming for years. Come anyway.' },
  { q: 'Is there anything after?',
    a: 'Coffee, and usually food. Someone will talk to you. This is not a place where a visitor gets to leave unnoticed.' },
];
---

<Base
  title="Services"
  description="Service times at Hamere Noah Kidane Mihret, the order of the Divine Liturgy, and what to expect on a first visit."
>
  <PageHeader
    eyebrow="Worship · አገልግሎት"
    geez="ቅዳሴ ወጸሎት"
    title="When we gather"
    lede="The order of the week, and what actually happens in it."
    image={u('/art/ura-interior.jpg')}
    imageAlt=""
  />

  <TodayStrip tone="light" />

  <!-- ══════════ the week ══════════ -->
  <section class="mx-auto max-w-[1240px] px-5 py-20 lg:px-8 lg:py-28">
    <div class="mx-auto mb-14 max-w-2xl text-center" data-reveal>
      <p class="rubric">The week · ሳምንቱ</p>
      <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">Service times</h2>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-600">
        Given twice: as the clock here reads, and as the Church counts the hours — from
        dawn, so that six in the morning is the twelfth hour.
      </p>
    </div>

    <div class="overflow-x-auto scrollbar-none">
      <table class="w-full min-w-[46rem] border-collapse">
        <caption class="sr-only">Weekly service times</caption>
        <thead>
          <tr class="border-b-2 border-gold-600/60">
            {['Day', 'Service', 'Time', 'ሰዓት', 'Notes'].map((h) => (
              <th scope="col" class="px-4 py-3 text-left font-ui text-[.68rem] font-600 tracking-[.2em] text-madder-700 uppercase">
                {h}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {SERVICES.map((s, i) => {
            const eth = ethiopianClockOf(s.from);
            return (
              <tr class="border-b border-[var(--rule)] transition-colors duration-300 hover:bg-gold-200/30"
                  data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <td class="px-4 py-5 align-top">
                  <span class="block font-display text-[1rem] whitespace-nowrap text-madder-800">{s.day}</span>
                  <span class="geez block text-[.82rem] text-gold-700">{s.dayGeez}</span>
                </td>
                <td class="px-4 py-5 align-top">
                  <span class="block font-display text-[1.05rem] text-ink-800">{s.title}</span>
                  <span class="geez block text-[.9rem] text-gold-700">{s.geez}</span>
                </td>
                <td class="px-4 py-5 align-top font-display text-[1rem] whitespace-nowrap text-ink-800">
                  {s.from}{s.toLabel && <span class="text-ink-500"> – {s.toLabel}</span>}
                </td>
                <td class="geez px-4 py-5 align-top text-[.95rem] whitespace-nowrap text-madder-700">{eth.text}</td>
                <td class="px-4 py-5 align-top text-[.94rem] leading-relaxed text-ink-600">{s.note}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-6 border border-gold-600/35 bg-gold-200/25 px-5 py-4 text-[.9rem] leading-relaxed text-ink-600" data-reveal>
      <strong class="font-600 text-madder-800">Before you set out:</strong> times shift for
      great feasts, and Lent has its own order entirely. Ring the office on{' '}
      <a href={PARISH.phoneHref} class="text-madder-700 underline underline-offset-2">{PARISH.phone}</a>{' '}
      if you are coming from any distance.
    </p>
  </section>

  <!-- ══════════ the order of the liturgy ══════════ -->
  <section class="relative overflow-hidden border-y border-[var(--rule)] bg-vellum-100/70">
    <div class="absolute inset-x-0 top-0 opacity-40"><Harag variant="vine" repeat={22} height={24} /></div>

    <div class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div data-reveal>
          <p class="rubric">Sunday morning · እሑድ ጠዋት</p>
          <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">What happens, in order</h2>
          <p class="mt-6 text-[1.05rem] leading-relaxed text-ink-600">
            A full Sunday runs four and a half hours and is really five services joined
            end to end. Knowing the shape of it makes the whole thing far easier to
            follow — and tells you when to arrive if you cannot manage all of it.
          </p>
          <div class="mt-8">
            <ArchFrame
              src={u('/art/timkat.jpg')}
              alt="A deacon in white looking out over a vast outdoor congregation on a hillside"
              ratio="4 / 3"
              caption="A great assembly at an outdoor feast. Ethiopian feasts are kept in the open because no building has ever been large enough."
              credit="Eyasusetegn · CC BY-SA 4.0 · Wikimedia Commons"
            />
          </div>
        </div>

        <ol class="border-t border-[var(--rule)]">
          {KIDASE_ORDER.map((k, i) => (
            <li class="grid grid-cols-[2.6rem_1fr] gap-x-5 border-b border-[var(--rule)] py-6"
                data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="geez pt-1 text-[1.2rem] leading-none text-gold-600">{toGeez(i + 1)}</span>
              <div>
                <p class="geez text-[1.3rem] leading-tight text-madder-900">{k.geez}</p>
                <p class="mt-1 flex flex-wrap items-baseline gap-x-3">
                  <span class="font-display text-[1.08rem] text-ink-800">{k.en}</span>
                  <span class="font-ui text-[.7rem] tracking-[.14em] text-gold-700 uppercase">{k.tr}</span>
                </p>
                <p class="mt-2 text-[.98rem] leading-relaxed text-ink-600">{k.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ══════════ visiting ══════════ -->
  <section id="visiting" class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-32">
    <div class="mx-auto mb-14 max-w-2xl text-center" data-reveal>
      <p class="rubric">First visit · ለመጀመሪያ ጊዜ</p>
      <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">Everything nobody tells you</h2>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-600">
        Written for someone who has never been inside an Ethiopian Orthodox church — and
        equally for the grandchild who has, but was too young to ask.
      </p>
    </div>

    <div class="mx-auto max-w-3xl divide-y divide-[var(--rule)] border-y border-[var(--rule)]">
      {EXPECT.map((e, i) => (
        <details class="group" data-reveal style={`--reveal-delay:${i * 50}ms`} open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 transition-colors duration-300 hover:text-madder-800 [&::-webkit-details-marker]:hidden">
            <span class="font-display text-[1.12rem] text-madder-900">{e.q}</span>
            <span class="grid h-7 w-7 shrink-0 place-items-center border border-gold-600/55 text-gold-700 transition-transform duration-300 group-open:rotate-45">
              <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
          </summary>
          <p class="pr-12 pb-6 text-[1.02rem] leading-[1.75] text-ink-700">{e.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Divider />

  <!-- ══════════ closing ══════════ -->
  <section class="relative overflow-hidden">
    <img src={u('/art/bete-giyorgis.jpg')} alt="" aria-hidden="true"
         class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-ink-950/80"></div>
    <div class="pointer-events-none absolute inset-6 border border-gold-500/22"></div>

    <div class="relative mx-auto max-w-2xl px-6 py-24 text-center lg:py-28">
      <p class="geez text-[clamp(1.4rem,4vw,2.2rem)] leading-snug text-gold-300" data-reveal>
        ቤትየ ቤተ ጸሎት ይሰመይ ለኵሉ አሕዛብ
      </p>
      <p class="mt-4 font-display text-[1.2rem] text-vellum-100" data-reveal>
        “My house shall be called a house of prayer for all peoples.”
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4" data-reveal>
        <a href={u('/visit')}
           class="border border-gold-500 bg-gold-500 px-7 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-gold-400">
          Directions &amp; contact
        </a>
        <a href={u('/calendar')}
           class="border border-vellum-200/35 px-7 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-vellum-100 uppercase transition-colors duration-300 hover:border-gold-400 hover:text-gold-300">
          Feasts &amp; fasts
        </a>
      </div>
    </div>
  </section>
</Base>
