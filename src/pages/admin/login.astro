---
import AdminLayout from '../../layouts/Admin.astro';
import { adminApiConfigured } from '../../lib/admin/client';
import { u } from '../../lib/url';
---

<AdminLayout title="Sign in">
  <main class="relative grid min-h-screen place-items-center overflow-hidden bg-lapis-950 px-5 py-12">
    <img src={u('/pics/inside church.jpg')} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-[.12]" />
    <div class="absolute inset-0 bg-gradient-to-br from-lapis-950 via-lapis-950/95 to-madder-950/90"></div>
    <div class="absolute inset-8 border border-gold-400/10" aria-hidden="true"></div>

    <section class="relative w-full max-w-md border border-gold-400/25 bg-vellum-50 p-7 shadow-2xl sm:p-10">
      <div class="mx-auto grid h-14 w-14 place-items-center border border-gold-700/35 text-madder-800">
        <svg viewBox="0 0 48 48" class="h-8 w-8" aria-hidden="true">
          <path d="M24 5v38M10 18h28M17 12v12M31 12v12M17 34h14" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </div>
      <div class="mt-6 text-center">
        <p class="geez text-[1.18rem] text-madder-900">ሐመረ ኖኅ ኪዳነ ምሕረት</p>
        <h1 class="mt-2 text-[1.65rem] text-lapis-950">Parish admin</h1>
        <p class="mt-2 text-[.9rem] leading-relaxed text-ink-500">Sign in to update parish news, celebrations, photographs, and blog stories.</p>
      </div>

      {adminApiConfigured ? (
        <form data-login-form class="mt-8 space-y-5">
          <label class="block">
            <span class="mb-2 block font-ui text-[.62rem] font-semibold tracking-[.13em] text-ink-600 uppercase">Email address</span>
            <input name="email" type="email" autocomplete="username" required class="w-full border border-ink-800/15 bg-white px-4 py-3 font-ui text-[.88rem] outline-none focus:border-gold-700 focus:ring-3 focus:ring-gold-600/10" />
          </label>
          <label class="block">
            <span class="mb-2 block font-ui text-[.62rem] font-semibold tracking-[.13em] text-ink-600 uppercase">Password</span>
            <input name="password" type="password" autocomplete="current-password" required class="w-full border border-ink-800/15 bg-white px-4 py-3 font-ui text-[.88rem] outline-none focus:border-gold-700 focus:ring-3 focus:ring-gold-600/10" />
          </label>
          <p data-login-error role="alert" class="hidden border-l-2 border-madder-700 bg-madder-300/10 px-4 py-3 text-[.84rem] text-madder-900"></p>
          <button type="submit" class="w-full bg-madder-800 px-5 py-3.5 font-ui text-[.68rem] tracking-[.14em] text-vellum-50 uppercase hover:bg-madder-900 disabled:cursor-wait disabled:opacity-70">Sign in securely</button>
        </form>
      ) : (
        <div class="mt-8 border border-gold-700/25 bg-gold-300/12 p-5 text-center">
          <p class="font-ui text-[.62rem] tracking-[.12em] text-gold-800 uppercase">Phase Two preview</p>
          <p class="mt-2 text-[.86rem] leading-relaxed text-ink-600">Secure sign-in activates when the separately hosted admin API is connected.</p>
          <a href={u('/admin')} class="mt-5 inline-flex bg-lapis-950 px-5 py-3 font-ui text-[.66rem] tracking-[.12em] text-vellum-50 uppercase hover:bg-lapis-900">Open dashboard preview</a>
        </div>
      )}

      <a href={u('/')} class="mt-7 flex items-center justify-center gap-2 font-ui text-[.62rem] tracking-[.1em] text-ink-500 uppercase hover:text-madder-800">← Return to website</a>
    </section>
  </main>

  <script>
    import { createAdminSession } from '../../lib/admin/client';

    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    const errorBox = document.querySelector<HTMLElement>('[data-login-error]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const values = new FormData(form);
      button?.setAttribute('disabled', '');
      if (button) button.textContent = 'Signing in…';
      errorBox?.classList.add('hidden');

      try {
        await createAdminSession(String(values.get('email')), String(values.get('password')));
        window.location.assign(`${import.meta.env.BASE_URL}admin`);
      } catch (error) {
        if (errorBox) {
          errorBox.textContent = error instanceof Error ? error.message : 'Unable to sign in.';
          errorBox.classList.remove('hidden');
        }
        button?.removeAttribute('disabled');
        if (button) button.textContent = 'Sign in securely';
      }
    });
  </script>
</AdminLayout>
