---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArchFrame from '../components/ornament/ArchFrame.astro';
import Divider from '../components/ornament/Divider.astro';
import Harag from '../components/ornament/Harag.astro';
import { MINISTRIES, PARISH } from '../lib/parish';
import { toGeez } from '../lib/ethiopic';
import { u } from '../lib/url';

const ICONS: Record<string, string> = {
  book:   'M4 4h7a2 2 0 012 2v14a2 2 0 00-2-2H4zM20 4h-7a2 2 0 00-2 2v14a2 2 0 012-2h7z',
  drum:   'M4 8c0-2.2 3.6-4 8-4s8 1.8 8 4v8c0 2.2-3.6 4-8 4s-8-1.8-8-4zM4 8c0 2.2 3.6 4 8 4s8-1.8 8-4M8 12l8 8M16 12l-8 8',
  scroll: 'M6 3h10a2 2 0 012 2v14a2 2 0 002 2H8a2 2 0 01-2-2zM9 8h7M9 12h7M9 16h4',
  star:   'M12 3l2.7 5.6 6.3.8-4.6 4.3 1.2 6.3L12 17l-5.6 3 1.2-6.3L3 9.4l6.3-.8z',
  hands:  'M7 11V5.5a1.5 1.5 0 013 0V11m0 0V4.5a1.5 1.5 0 013 0V11m0 0V6.5a1.5 1.5 0 013 0V13a7 7 0 01-7 7H9a5 5 0 01-5-5v-4a1.5 1.5 0 013 0z',
  cross:  'M12 3v18M6 8h12M9 8v13M15 8v13',
};

const YOUTH = [
  { geez: 'ግዕዝ ፊደል', tr: 'Ge’ez letters', body: 'The syllabary — two hundred and thirty-one characters — taught the way it always has been, by chanting the columns aloud.' },
  { geez: 'ታሪከ ቤተ ክርስቲያን', tr: 'Church history', body: 'From the eunuch on the Gaza road to the parish they are standing in. Children who know where they come from stay.' },
  { geez: 'ዝማሬ', tr: 'Zema', body: 'The chant of St Yared, learned by ear from someone who learned it by ear. There is no other way to learn it.' },
  { geez: 'የቅዱሳን ገድል', tr: 'Lives of the saints', body: 'Tekle Haymanot, Gebre Menfes Kidus, Yared, Giorgis — told as stories, because that is what they are.' },
];
---

<Base
  title="Community"
  description="Sunday school, chant, the parish council, and the ministries of Hamere Noah Kidane Mihret in Sioux Falls."
>
  <PageHeader
    eyebrow="Community · ማኅበረሰብ"
    geez="ማኅበረ ምእመናን"
    title="The life of the parish"
    lede="What happens here between one Sunday and the next."
    image={u('/art/procession.jpg')}
    imageAlt=""
  />

  <!-- ══════════ ministries ══════════ -->
  <section class="mx-auto max-w-[1240px] px-5 py-20 lg:px-8 lg:py-28">
    <div class="mx-auto mb-16 max-w-2xl text-center" data-reveal>
      <p class="rubric">Ministries · አገልግሎቶች</p>
      <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">Everyone has something to carry</h2>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-600">
        A parish this size runs on its members. Nothing below is staffed; all of it is
        carried by people who also have jobs.
      </p>
    </div>

    <div class="grid gap-px border border-[var(--rule)] bg-[var(--rule)] sm:grid-cols-2 lg:grid-cols-3">
      {MINISTRIES.map((m, i) => (
        <article class="group bg-vellum-50/80 p-8 transition-colors duration-500 hover:bg-gold-200/40 lg:p-9"
                 data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none"
               stroke="var(--color-madder-800)" stroke-width="1.3"
               stroke-linecap="round" stroke-linejoin="round"
               class="transition-transform duration-500 group-hover:-translate-y-0.5" aria-hidden="true">
            <path d={ICONS[m.icon]} />
          </svg>
          <p class="geez mt-5 text-[1.35rem] leading-tight text-madder-900">{m.geez}</p>
          <p class="mt-1 flex flex-wrap items-baseline gap-x-3">
            <span class="font-display text-[1.08rem] text-ink-800">{m.en}</span>
            <span class="font-ui text-[.68rem] tracking-[.14em] text-gold-700 uppercase">{m.tr}</span>
          </p>
          <p class="mt-3 text-[.99rem] leading-relaxed text-ink-600">{m.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════ sunday school ══════════ -->
  <section class="relative overflow-hidden border-y border-[var(--rule)] bg-vellum-100/70">
    <div class="absolute inset-x-0 top-0 opacity-40"><Harag variant="vine" repeat={22} height={24} /></div>
    <div class="absolute inset-x-0 bottom-0 opacity-40"><Harag variant="vine" repeat={22} height={24} flip /></div>

    <div class="mx-auto max-w-[1240px] px-5 py-24 lg:px-8 lg:py-28">
      <div class="grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
        <div data-reveal>
          <p class="rubric">Sunday school · ሰንበት ትምህርት ቤት</p>
          <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]">
            The generation that will keep this
          </h2>
          <div class="reading mt-7 text-[1.05rem] leading-[1.75] text-ink-700">
            <p class="dropcap">
              A diaspora parish has one problem that a parish in Addis does not: the
              children. They are American. They dream in English. The liturgy that holds
              their parents will not hold them by inheritance alone — it has to be taught,
              deliberately, in a language they actually think in.
            </p>
            <p>
              So the Sunday school here teaches in both. Amharic for the ones who have it,
              English for the ones who do not, and Ge’ez for everyone, because the Ge’ez
              is the point.
            </p>
          </div>

          <ul class="mt-9 space-y-px border border-[var(--rule)] bg-[var(--rule)]">
            {YOUTH.map((y, i) => (
              <li class="flex items-baseline gap-4 bg-vellum-50/80 p-5">
                <span class="geez shrink-0 text-[1rem] text-gold-600">{toGeez(i + 1)}</span>
                <div>
                  <p class="flex flex-wrap items-baseline gap-x-3">
                    <span class="geez text-[1.1rem] text-madder-900">{y.geez}</span>
                    <span class="font-display text-[1rem] text-ink-700">{y.tr}</span>
                  </p>
                  <p class="mt-1 text-[.95rem] leading-relaxed text-ink-600">{y.body}</p>
                </div>
              </li>
            ))}
          </ul>

          <p class="mt-7 text-[.95rem] leading-relaxed text-ink-600">
            Classes follow the Liturgy on Sunday. New students are welcome any week —
            speak to a teacher after the service, or ring the office on{' '}
            <a href={PARISH.phoneHref} class="text-madder-700 underline underline-offset-2">{PARISH.phone}</a>.
          </p>
        </div>

        <div data-reveal style="--reveal-delay:140ms">
          <ArchFrame
            src={u('/art/manuscript-zechariah.jpg')}
            alt="A page from an Ethiopian illuminated Bible showing the annunciation to Zechariah"
            ratio="3 / 4"
            caption="The annunciation to Zechariah, from an Ethiopic Bible. Ge’ez is still taught from pages like this one — read aloud, in column, until the letters stick."
            credit="British Library Add. MS 59874 · Public domain"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ mutual aid ══════════ -->
  <section class="relative overflow-hidden bg-ink-950 text-vellum-200">
    <img src={u('/art/priest-tigray.jpg')} alt="" aria-hidden="true"
         class="absolute inset-0 h-full w-full object-cover opacity-[.13]" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-950/88 to-ink-950"></div>

    <div class="relative mx-auto max-w-3xl px-6 py-24 text-center lg:py-28">
      <p class="rubric !text-gold-400/85" data-reveal>Standing together · ዕድር</p>
      <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)] text-vellum-100" data-reveal>
        When something happens to one household
      </h2>
      <p class="mx-auto mt-7 max-w-xl text-[1.05rem] leading-relaxed text-vellum-200/72" data-reveal>
        An Ethiopian parish is also, frankly, an insurance policy. When someone dies, the
        church cooks, the church sits with the family for the days of mourning, the church
        organises the funeral and comes back on the fortieth day and again every year for
        the tezkar. When someone is in hospital, the priest comes. When a family is in
        difficulty, it is generally handled before anyone has had to ask publicly.
      </p>
      <p class="mx-auto mt-5 max-w-xl text-[1.05rem] leading-relaxed text-vellum-200/72" data-reveal>
        This is not a programme. It is what the word “parish” has always meant.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4" data-reveal>
        <a href={u('/membership')}
           class="border border-gold-500 bg-gold-500 px-7 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-ink-950 uppercase transition-colors duration-300 hover:bg-gold-400">
          Become a member
        </a>
        <a href={PARISH.phoneHref}
           class="border border-vellum-200/35 px-7 py-3.5 font-ui text-[.8rem] tracking-[.14em] text-vellum-100 uppercase transition-colors duration-300 hover:border-gold-400 hover:text-gold-300">
          {PARISH.phone}
        </a>
      </div>
    </div>
  </section>

  <Divider />
</Base>
