---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Divider from '../components/ornament/Divider.astro';
import { PARISH } from '../lib/parish';
import { u } from '../lib/url';

const CARE = [
  { id: 'funeral', title: 'Funeral & memorial', gee: 'ቀብር እና ተዝካር', image: '/art/community/funeral.jpg', alt: 'Ethiopian Orthodox priest serving at a burial', label: 'Standing with one another', body: 'The parish accompanies a family through bereavement with prayer, practical help, and the funeral service. Memorial prayers and remembrance are arranged with the priest and family according to their needs and the Church’s practice.', next: 'If your family is facing a loss, contact the parish as soon as you can so the priest and community can walk with you.' },
  { id: 'baptism', title: 'Baptism', gee: 'ጥምቀት', image: '/art/community/baptism-family.jpg', alt: 'Mother and child at an Ethiopian Orthodox baptism ceremony', label: 'Beginning life in the Church', body: 'Baptism is new birth into Christ and entrance into the life of the Church. Families should speak with the priest early about preparation, the child’s baptism, and the role of godparents. Adults seeking baptism receive instruction before the sacrament.', next: 'Call the parish office to speak with the priest about preparation and scheduling.' },
  { id: 'matrimony', title: 'Matrimony', gee: 'ተክሊል', image: '/art/community/matrimony.jpg', alt: 'A couple and their community during an Ethiopian Orthodox church wedding', label: 'The sacrament of holy matrimony', body: 'The Church blesses marriage as a sacrament and a shared Christian life. Couples should begin by meeting with the priest well ahead of a planned wedding to discuss church requirements, pastoral preparation, and the service itself.', next: 'Contact the parish before setting a date; the priest will guide each couple through the next steps.' },
  { id: 'confession', title: 'Confession', gee: 'ንስሐ', image: '/art/priest-cross.jpg', alt: 'Ethiopian Orthodox priest holding a processional cross', label: 'Returning to the life of prayer', body: 'Confession is a sacrament of repentance and reconciliation, normally made with one’s spiritual father. The priest offers guidance in preparing for confession and receiving the sacrament, including preparation for Holy Communion.', next: 'Speak privately with the priest to arrange a time for confession and pastoral guidance.' },
];
---

<Base title="Community" description="Pastoral care, sacraments, and the shared life of the Hamere Noah Kidane Mihret community.">
  <PageHeader
    eyebrow="Community · Parish life"
    geez=""
    title="The parish walks with you"
    lede="In joy, in grief, and at every turning point, the life of faith is carried together."
    image={u('/pics/communitity10.jpg')}
    imageAlt="Families gathered for a parish community event"
  />

  <section class="mx-auto max-w-[1240px] px-5 py-20 lg:px-8 lg:py-28">
    <header class="mx-auto mb-14 max-w-2xl text-center" data-reveal>
      <p class="rubric">Pastoral care · አገልግሎት</p>
      <h2 class="mt-4 text-[clamp(1.8rem,4vw,2.65rem)]">For the moments that shape a life</h2>
      <p class="mt-5 text-[1.04rem] leading-relaxed text-ink-600">The parish and its priest can help you understand what to expect and how to prepare. Every family's situation is different; begin with a conversation.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {CARE.map((item, i) => (
        <article id={item.id} class="overflow-hidden border border-[var(--rule)] bg-vellum-50/85 shadow-panel" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <div class="grid sm:grid-cols-[.82fr_1.18fr]">
            <img src={u(item.image)} alt={item.alt} class="aspect-[4/3] h-full w-full object-cover sm:aspect-auto" loading="lazy" />
            <div class="p-6 sm:p-8">
              <p class="rubric">{item.label}</p>
              <h3 class="mt-3 text-[1.55rem] text-madder-900">{item.title}</h3>
              <p class="geez mt-1 text-[1rem] text-gold-800">{item.gee}</p>
              <p class="mt-4 text-[.96rem] leading-relaxed text-ink-600">{item.body}</p>
              <p class="mt-4 border-l-2 border-gold-600/55 pl-4 text-[.9rem] leading-relaxed text-ink-700">{item.next}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-[var(--rule)] bg-vellum-100/70">
    <div class="mx-auto grid max-w-[1100px] gap-8 px-5 py-16 md:grid-cols-[1fr_auto] md:items-center lg:px-8">
      <div>
        <p class="rubric">A first conversation</p>
        <h2 class="mt-3 text-[1.75rem]">You do not need to know the right words</h2>
        <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed text-ink-600">Call the parish office and tell us what is happening. We will connect you with the priest and help you take the next step.</p>
      </div>
      <a href={PARISH.phoneHref} class="inline-flex justify-center border border-madder-800 bg-madder-800 px-7 py-3.5 font-ui text-[.75rem] tracking-[.14em] text-vellum-50 uppercase transition hover:bg-madder-900">Call {PARISH.phone}</a>
    </div>
  </section>
  <Divider />
</Base>
