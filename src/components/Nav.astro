---
import { PARISH } from '../lib/parish';
import { u } from '../lib/url';

interface Props {
  /** the page opens on a dark hero, so the bar must read light until it scrolls */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
interface NavLink {
  href: string;
  en: string;
  geez: string;
  children?: NavLink[];
}

const SERVICE_LINKS: NavLink[] = [
  { href: '/calendar',  en: 'Calendar',  geez: 'በዓላት' },
  { href: '/community', en: 'Community', geez: 'ማኅበረሰብ' },
  { href: '/gallery',   en: 'Gallery',   geez: 'ሥዕላት' },
];

const LINKS: NavLink[] = [
  { href: '/about',    en: 'About',     geez: 'ስለ እኛ' },
  { href: '/faith',    en: 'Our Faith', geez: 'እምነታችን' },
  { href: '/services', en: 'Services',  geez: 'አገልግሎት', children: SERVICE_LINKS },
  { href: '/visit',    en: 'Visit',     geez: 'ጎብኙን' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const isLinkActive = (link: NavLink) =>
  isActive(link.href) || Boolean(link.children?.some((child) => isActive(child.href)));
---

<header
  data-header
  data-over-hero={overHero ? '' : undefined}
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,border-color] duration-500"
>
  <!-- the thin woven band along the very top, as on a church curtain -->
  <div class="h-[3px] tilet-band opacity-80"></div>

  <div
    class="border-b border-transparent bg-transparent transition-[background-color,border-color,backdrop-filter] duration-500 [.is-scrolled_&]:border-[var(--rule)] [.is-scrolled_&]:bg-[color-mix(in_oklab,var(--color-vellum)_88%,transparent)] [.is-scrolled_&]:backdrop-blur-md"
  >
    <div class="mx-auto flex max-w-[1240px] items-center gap-6 px-5 py-3 lg:px-8">
      <!-- ── mark ── -->
      <a href={u("/")} class="group flex shrink-0 items-center gap-3" aria-label={`${PARISH.name} — home`}>
        <svg viewBox="0 0 100 100" width="40" height="40" fill="none" aria-hidden="true" class="shrink-0">
          <circle cx="50" cy="50" r="47" stroke-width="1.5" opacity=".7" class="nav-mark-ring" />
          <g stroke-width="6" stroke-linecap="round" stroke-linejoin="round" class="nav-mark-cross transition-transform duration-700 group-hover:rotate-[15deg]" style="transform-origin:50% 50%">
            <path d="M50 14 V86 M22 38 H78" />
            <rect x="38" y="38" width="24" height="24" rx="2" />
          </g>
          <circle cx="50" cy="50" r="4" class="nav-mark-dot" />
        </svg>
        <span class="leading-[1.12]">
          <span class="nav-brand-en block font-display text-[.95rem] font-700 tracking-[.02em] transition-colors duration-500 sm:text-[1.02rem]"
            >Hamere Noah</span
          >
          <span class="nav-brand-geez geez block text-[.72rem] transition-colors duration-500">ሐመረ ኖኅ ኪዳነ ምሕረት</span>
        </span>
      </a>

      <!-- ── links ── -->
      <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
        {LINKS.map((l) => l.children ? (
          <div class="nav-dropdown relative">
            <a
              href={u(l.href)}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class="nav-link group relative rounded-sm px-3 py-2 text-center font-ui text-[.82rem] transition-colors duration-300"
            >
              <span class="flex items-center justify-center gap-1.5 leading-tight">
                {l.en}
                <svg class="nav-dropdown-chevron h-2.5 w-2.5 transition-transform duration-300" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
              <span class="nav-link-sub geez block text-[.6rem] leading-tight transition-colors duration-500">{l.geez}</span>
              <span
                class:list={[
                  'absolute inset-x-3 -bottom-px h-px origin-center bg-gold-600 transition-transform duration-300',
                  isLinkActive(l) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                ]}
              ></span>
            </a>

            <div class="nav-dropdown-panel absolute top-full left-1/2 w-60 -translate-x-1/2 pt-3">
              <div class="border border-gold-700/30 bg-vellum-50 p-2 shadow-lifted">
                <p class="border-b border-[var(--rule)] px-3 py-2 font-ui text-[.58rem] tracking-[.16em] text-gold-800 uppercase">
                  Parish life · የደብሩ ሕይወት
                </p>
                {l.children.map((child) => (
                  <a
                    href={u(child.href)}
                    aria-current={isActive(child.href) ? 'page' : undefined}
                    class:list={[
                      'flex items-center justify-between gap-4 px-3 py-3 font-ui text-[.78rem] transition-colors hover:bg-gold-200/45 hover:text-madder-900',
                      isActive(child.href) ? 'bg-gold-200/35 text-madder-900' : 'text-ink-800',
                    ]}
                  >
                    <span>{child.en}</span>
                    <span class="geez text-[.7rem] text-gold-700">{child.geez}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={u(l.href)}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class="nav-link group relative rounded-sm px-3 py-2 text-center font-ui text-[.82rem] transition-colors duration-300"
          >
            <span class="block leading-tight">{l.en}</span>
            <span class="nav-link-sub geez block text-[.6rem] leading-tight transition-colors duration-500">{l.geez}</span>
            <span
              class:list={[
                'absolute inset-x-3 -bottom-px h-px origin-center bg-gold-600 transition-transform duration-300',
                isActive(l.href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
              ]}
            ></span>
          </a>
        ))}
      </nav>

      <a
        href={u('/give')}
        class="nav-cta hidden shrink-0 border border-madder-800 bg-madder-800 px-4 py-2 font-ui text-[.78rem] tracking-[.09em] text-vellum-50 uppercase transition-colors duration-500 hover:bg-madder-900 lg:inline-block"
        >Give</a
      >

      <!-- ── mobile ── -->
      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="nav-burger ml-auto flex h-10 w-10 items-center justify-center border transition-colors duration-500 lg:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </button>
    </div>
  </div>

  <!-- ── mobile sheet ── -->
  <div
    id="mobile-nav"
    data-menu
    hidden
    class="border-b border-[var(--rule)] bg-vellum-100/97 backdrop-blur-md lg:hidden"
  >
    <nav class="mx-auto max-w-[1240px] px-5 py-4" aria-label="Main, mobile">
      {LINKS.map((l) => (
        <div class="border-b border-[var(--rule)]">
          <a
            href={u(l.href)}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'flex items-baseline justify-between py-3 font-ui text-[.95rem]',
              isLinkActive(l) ? 'text-madder-800' : 'text-ink-800',
            ]}
          >
            <span>{l.en}</span>
            <span class="geez text-[.8rem] text-gold-700">{l.geez}</span>
          </a>

          {l.children && (
            <div class="mb-3 ml-2 border-l border-gold-700/35 pl-4">
              {l.children.map((child) => (
                <a
                  href={u(child.href)}
                  aria-current={isActive(child.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-baseline justify-between py-2.5 font-ui text-[.82rem]',
                    isActive(child.href) ? 'text-madder-800' : 'text-ink-600',
                  ]}
                >
                  <span>{child.en}</span>
                  <span class="geez text-[.7rem] text-gold-700">{child.geez}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href={u('/give')} class="mt-4 block bg-madder-800 py-3 text-center font-ui text-sm tracking-[.09em] text-vellum-50 uppercase">Give</a>
      <a href={u('/membership')} class="mt-2 block border border-[var(--rule)] py-3 text-center font-ui text-sm tracking-[.09em] text-ink-800 uppercase">Become a member</a>
    </nav>
  </div>
</header>

<style>
  .nav-dropdown-panel {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -0.35rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms;
  }

  .nav-dropdown:hover .nav-dropdown-panel,
  .nav-dropdown:focus-within .nav-dropdown-panel {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .nav-dropdown:hover .nav-dropdown-chevron,
  .nav-dropdown:focus-within .nav-dropdown-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown-panel,
    .nav-dropdown-chevron {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector('[data-menu-btn]');
  const menu = document.querySelector('[data-menu]') as HTMLElement | null;
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
