---
/**
 * A picture set in an arch, the way an icon is set into the wall of a church:
 * the shouldered Aksumite opening, a double rule of gold around it, and a
 * small floret at each spring of the arch.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  ratio?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  /** darken the image so text can sit over it */
  scrim?: boolean;
  position?: string;
}
const {
  src, alt, caption, credit,
  ratio = '3 / 4',
  class: cls = '',
  loading = 'lazy',
  scrim = false,
  position = 'center',
} = Astro.props;

const uid = 'ar' + Math.random().toString(36).slice(2, 8);
---

<figure class={`group relative ${cls}`}>
  <div class="relative">
    {/* the gold rule stands off the picture by a hair, as gesso would */}
    <div
      class="absolute -inset-[7px] pointer-events-none"
      style={`clip-path:url(#${uid}); background:linear-gradient(150deg,var(--color-gold-600),var(--color-gold-300) 38%,var(--color-gold-700) 62%,var(--color-gold-500));`}
    ></div>
    <div
      class="absolute -inset-[2px] pointer-events-none"
      style={`clip-path:url(#${uid}); background:var(--color-vellum);`}
    ></div>

    <div class="relative overflow-hidden" style={`clip-path:url(#${uid}); aspect-ratio:${ratio};`}>
      <img
        src={src} alt={alt} loading={loading}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.045]"
        style={`object-position:${position}`}
      />
      {scrim && (
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-ink-950/20 to-transparent"></div>
      )}
    </div>

    {/* florets where the arch springs from the jambs */}
    <svg class="absolute left-0 top-[16%] -translate-x-1/2 -translate-y-1/2 text-gold-600" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 1 L12.4 7.6 L19 10 L12.4 12.4 L10 19 L7.6 12.4 L1 10 L7.6 7.6 Z" fill="currentColor" opacity=".9"/>
    </svg>
    <svg class="absolute right-0 top-[16%] translate-x-1/2 -translate-y-1/2 text-gold-600" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 1 L12.4 7.6 L19 10 L12.4 12.4 L10 19 L7.6 12.4 L1 10 L7.6 7.6 Z" fill="currentColor" opacity=".9"/>
    </svg>
  </div>

  {/* the arch itself, defined once as a clip path in normalised space */}
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <clipPath id={uid} clipPathUnits="objectBoundingBox">
        {/* shoulders rise straight, then a horseshoe turn closes the head */}
        <path d="M0.5,0 C0.79,0 0.97,0.075 0.985,0.155 C0.997,0.225 1,0.27 1,0.30 L1,1 L0,1 L0,0.30 C0,0.27 0.003,0.225 0.015,0.155 C0.03,0.075 0.21,0 0.5,0 Z" />
      </clipPath>
    </defs>
  </svg>

  {(caption || credit) && (
    <figcaption class="mt-4 text-sm leading-relaxed text-ink-600">
      {caption && <span class="font-serif text-ink-700">{caption}</span>}
      {credit && <span class="mt-0.5 block font-ui text-[.68rem] tracking-wide text-ink-500">{credit}</span>}
    </figcaption>
  )}
</figure>
