---
/**
 * The ceiling of Debre Berhan Selassie at Gondar is covered with rows of
 * winged faces — a hundred and thirty-five of them, looking down on the nave.
 * They are packed edge to edge: a round face with great almond eyes, brows
 * joined in one arch, and broad wings that reach almost to the neighbouring
 * face on either side.
 *
 * The band scales with its container and never crops, so every row is whole.
 */
interface Props {
  count?: number;
  rows?: number;
  class?: string;
  opacity?: number;
  /** 'painted' keeps the four pigments; 'gilt' renders in gold alone, for use
      over a photograph where full colour would fight the image */
  tone?: 'painted' | 'gilt';
  /** cap the rendered height so a wide viewport doesn't make a mural of it */
  maxHeight?: number;
}
const {
  count = 12, rows = 1, class: cls = '', opacity = 1,
  tone = 'painted', maxHeight,
} = Astro.props;

const gilt = tone === 'gilt';
const F = gilt
  ? ['var(--color-gold-600)', 'var(--color-gold-700)', 'var(--color-gold-800)']
  : ['var(--color-madder-700)', 'var(--color-gold-600)', 'var(--color-malachite-700)'];
const OUTLINE = gilt ? 'var(--color-gold-900)' : 'var(--color-ink-900)';
// the faces at Gondar are painted in warm ochre, not white
const FACE    = gilt ? 'var(--color-gold-300)' : '#E8CBA0';
const FACE_SH = gilt ? 'var(--color-gold-400)' : '#D6AF7E';
const HAIR    = gilt ? 'var(--color-gold-900)' : 'var(--color-ink-900)';
const WHITE   = gilt ? 'var(--color-vellum-50)' : '#FFFDF6';
const PUPIL   = gilt ? 'var(--color-gold-900)' : 'var(--color-ink-950)';
const LIP     = gilt ? 'var(--color-gold-800)' : 'var(--color-madder-800)';

const CELL = 100;
const CELL_H = 88;
const W = CELL * count;
const H = CELL_H * rows;
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid meet"
  fill="none"
  class={cls}
  style={`width:100%;height:auto;opacity:${opacity};${maxHeight ? `max-height:${maxHeight}px;` : ''}`}
  aria-hidden="true"
>
  {Array.from({ length: rows }, (_, r) =>
    // one extra cell each side so the courses run off the edge, as on a ceiling
    Array.from({ length: count + 2 }, (_, i) => {
      const x = (i - 1) * CELL + (r % 2 ? CELL / 2 : 0);
      const y = r * CELL_H;
      return (
        <g transform={`translate(${x} ${y})`}>
          {/* ── wings: three ranks each side. Kept subordinate to the face —
                on the real ceiling the head is what carries the image. ── */}
          {[1, -1].map((s) => (
            <g
              transform={s === -1 ? `translate(${CELL} 0) scale(-1 1)` : undefined}
              stroke={OUTLINE} stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"
            >
              {/* upper covert — sweeps up and out from the shoulder */}
              <path d="M28 36 Q17 25 3 29 Q11 39 27 43 Z" fill={F[0]} fill-opacity=".95" />
              <path d="M23 38 L7 31.5 M18 40 L11 36" stroke-width=".75" opacity=".42" />
              {/* middle rank — the widest, running level */}
              <path d="M28 44 Q15 41 1 48 Q13 55 28 51 Z" fill={F[1]} fill-opacity=".95" />
              <path d="M23 46 L5 46.5 M18 48 L9 50" stroke-width=".75" opacity=".42" />
              {/* the long primaries, falling away below */}
              <path d="M29 52 Q17 55 6 67 Q19 67 31 58 Z" fill={F[2]} fill-opacity=".95" />
              <path d="M25 55.5 L12 63.5 M21 57.5 L16 62" stroke-width=".75" opacity=".42" />
            </g>
          ))}

          {/* ── the face ── */}
          <ellipse cx="50" cy="43" rx="24" ry="26" fill={FACE} stroke={OUTLINE} stroke-width="2" />
          {/* a shadow along the jaw, the way the painters model a cheek */}
          <path d="M28 48 Q32 66 50 69 Q68 66 72 48 Q66 62 50 64 Q34 62 28 48 Z"
                fill={FACE_SH} opacity=".55" />

          {/* hair, a dark cap over the crown and down past the temples */}
          <path d="M26.5 40 Q28 17 50 17 Q72 17 73.5 40 Q69 28 50 27 Q31 28 26.5 40 Z"
                fill={HAIR} stroke={OUTLINE} stroke-width="1.4" stroke-linejoin="round" />

          {/* the single joined brow-arch that gives these faces their gravity */}
          <path d="M33 39 Q42 29 50 36.5 Q58 29 67 39"
                stroke={OUTLINE} stroke-width="2.3" fill="none" stroke-linecap="round" />

          {/* the great almond eyes */}
          <path d="M32 46.5 Q41 38 50 46.5 Q41 55 32 46.5 Z" fill={WHITE} stroke={OUTLINE} stroke-width="1.7" />
          <path d="M50 46.5 Q59 38 68 46.5 Q59 55 50 46.5 Z" fill={WHITE} stroke={OUTLINE} stroke-width="1.7" />
          <circle cx="41" cy="46.5" r="3.9" fill={PUPIL} />
          <circle cx="59" cy="46.5" r="3.9" fill={PUPIL} />

          {/* nose and mouth, reduced to the fewest possible strokes */}
          <path d="M50 50.5 L50 59.5 Q47.4 62 45 60.6"
                stroke={OUTLINE} stroke-width="1.6" fill="none" stroke-linecap="round" />
          <path d="M43.5 65 Q50 68.6 56.5 65" stroke={LIP} stroke-width="1.9" fill="none" stroke-linecap="round" />
        </g>
      );
    })
  )}
</svg>
